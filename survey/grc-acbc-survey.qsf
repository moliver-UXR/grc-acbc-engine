":"Recipient","Field":"acbcSessionId","VariableType":"Nominal","DataVisibility":[],"Value":""},{"Description":"acbcTaskJson","Type":"Recipient","Field":"acbcTaskJson","VariableType":"Nominal","DataVisibility":[],"Value":""},{"Description":"acbcPhase","Type":"Recipient","Field":"acbcPhase","VariableType":"Nominal","DataVisibility":[],"Value":""},{"Description":"acbcIteration","Type":"Recipient","Field":"acbcIteration","VariableType":"Nominal","DataVisibility":[],"Value":"0"},{"Description":"acbcDone","Type":"Recipient","Field":"acbcDone","VariableType":"Nominal","DataVisibility":[],"Value":"false"},{"Description":"acbcChoice","Type":"Recipient","Field":"acbcChoice","VariableType":"Nominal","DataVisibility":[],"Value":""},{"Description":"acbcTaskId","Type":"Recipient","Field":"acbcTaskId","VariableType":"Nominal","DataVisibility":[],"Value":""},{"Description":"acbcTaskType","Type":"Recipient","Field":"acbcTaskType","VariableType":"Nominal","DataVisibility":[],"Value":""},{"Description":"acbcLastTaskFull","Type":"Recipient","Field":"acbcLastTaskFull","VariableType":"Nominal","DataVisibility":[],"Value":""},{"Description":"profile_segment","Type":"Recipient","Field":"profile_segment","VariableType":"Nominal","DataVisibility":[],"Value":""},{"Description":"profile_currentProvider","Type":"Recipient","Field":"profile_currentProvider","VariableType":"Nominal","DataVisibility":[],"Value":""},{"Description":"profile_frameworks","Type":"Recipient","Field":"profile_frameworks","VariableType":"Nominal","DataVisibility":[],"Value":""},{"Description":"profile_deploymentPref","Type":"Recipient","Field":"profile_deploymentPref","VariableType":"Nominal","DataVisibility":[],"Value":""},{"Description":"profile_aiComfort","Type":"Recipient","Field":"profile_aiComfort","VariableType":"Nominal","DataVisibility":[],"Value":""},{"Description":"profile_tprmActive","Type":"Recipient","Field":"profile_tprmActive","VariableType":"Nominal","DataVisibility":[],"Value":""},{"Description":"profile_product_area","Type":"Recipient","Field":"profile_product_area","VariableType":"Nominal","DataVisibility":[],"Value":""},{"Description":"profile_ttv_importance","Type":"Recipient","Field":"profile_ttv_importance","VariableType":"Nominal","DataVisibility":[],"Value":""},{"Description":"QID_segment_recode","Type":"Recipient","Field":"QID_segment_recode","VariableType":"Nominal","DataVisibility":[],"Value":"${q://QIDsegment/SelectedChoicesRecode}"},{"Description":"QID_deployment_recode","Type":"Recipient","Field":"QID_deployment_recode","VariableType":"Nominal","DataVisibility":[],"Value":"${q://QIDdeployment/SelectedChoicesRecode}"},{"Description":"QID_ai_comfort_recode","Type":"Recipient","Field":"QID_ai_comfort_recode","VariableType":"Nominal","DataVisibility":[],"Value":"${q://QIDaicomfort/SelectedChoicesRecode}"},{"Description":"QID_tprm_recode","Type":"Recipient","Field":"QID_tprm_recode","VariableType":"Nominal","DataVisibility":[],"Value":"${q://QIDtprm/SelectedChoicesRecode}"},{"Description":"QID_frameworks_recodes","Type":"Recipient","Field":"QID_frameworks_recodes","VariableType":"Nominal","DataVisibility":[],"Value":"${q://QIDframeworks/SelectedChoicesRecode}"},{"Description":"QID_provider_text","Type":"Recipient","Field":"QID_provider_text","VariableType":"Nominal","DataVisibility":[],"Value":"${q://QIDprovider/ChoiceTextEntryValue}"},{"Description":"QID_product_area_recode","Type":"Recipient","Field":"QID_product_area_recode","VariableType":"Nominal","DataVisibility":[],"Value":"${q://QIDproductarea/SelectedChoicesRecode}"},{"Description":"QID_ttv_importance_recode","Type":"Recipient","Field":"QID_ttv_importance_recode","VariableType":"Nominal","DataVisibility":[],"Value":"${q://QIDttv/SelectedChoicesRecode}"}]},{"Type":"Block","FlowID":"FL_3","BlockID":"BL_consent"},{"Type":"Block","FlowID":"FL_4","BlockID":"BL_profile"},{"Type":"WebService","FlowID":"FL_5","URL":"${e://Field/acbcEngineUrl}/init","Method":"POST","RequestParams":[],"EditBodyParams":[{"ke