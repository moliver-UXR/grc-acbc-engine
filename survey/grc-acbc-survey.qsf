{"SurveyEntry":{"SurveyID":"SV_grcAcbc2026","SurveyName":"GRC Buyer Conjoint Study (UX1-275)","SurveyDescription":"Adaptive Choice-Based Conjoint (ACBC) for GRC buyer preferences. Q3 2026. UX1-275. Engine: moliver-UXR/grc-acbc-engine.","SurveyOwnerID":"UR_placeholder","SurveyBrandID":"placeholder","DivisionID":null,"SurveyLanguage":"EN","SurveyActiveResponseSet":"RS_placeholder","SurveyStatus":"Inactive","SurveyStartDate":"0000-00-00 00:00:00","SurveyExpirationDate":"0000-00-00 00:00:00","SurveyCreationDate":"2026-06-24 00:00:00","CreatorID":"UR_placeholder","LastModified":"2026-06-24 00:00:00","LastAccessed":"0000-00-00 00:00:00","LastActivated":"0000-00-00 00:00:00","Deleted":null},"SurveyElements":[{"SurveyID":"SV_grcAcbc2026","Element":"BL","PrimaryAttribute":"Survey Blocks","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":[{"Type":"Default","SubType":"","Description":"Consent and Screener","ID":"BL_consent","BlockElements":[{"Type":"Question","QuestionID":"QID_intro"},{"Type":"Question","QuestionID":"QID_s1","SkipLogic":[{"SkipLogicID":1,"ChoiceLocator":"q://QID_s1/SelectableChoice/5","Condition":"Selected","SkipToDestination":"ENDOFSURVEY","Locator":"q://QID_s1/SelectableChoice/5","Description":"Role: Other — does not qualify","QuestionID":"QID_s1"}]},{"Type":"Question","QuestionID":"QID_s2","SkipLogic":[{"SkipLogicID":1,"ChoiceLocator":"q://QID_s2/SelectableChoice/1","Condition":"Selected","SkipToDestination":"ENDOFSURVEY","Locator":"q://QID_s2/SelectableChoice/1","Description":"Fewer than 100 employees — does not qualify","QuestionID":"QID_s2"}]},{"Type":"Question","QuestionID":"QID_s3","SkipLogic":[{"SkipLogicID":1,"ChoiceLocator":"q://QID_s3/SelectableChoice/2","Condition":"Selected","SkipToDestination":"ENDOFSURVEY","Locator":"q://QID_s3/SelectableChoice/2","Description":"No GRC platform in use — does not qualify","QuestionID":"QID_s3"}]},{"Type":"Question","QuestionID":"QID_s4","SkipLogic":[{"SkipLogicID":1,"ChoiceLocator":"q://QID_s4/Selecta